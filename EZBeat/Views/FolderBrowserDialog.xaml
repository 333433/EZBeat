<Window x:Class="Views.FolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Select Folder"
        Height="500" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border x:Name="MainBorder"
        Background="{StaticResource EZBeat.Background.Tertiary}"
        BorderBrush="{StaticResource EZBeat.Control.Border}"
        BorderThickness="1"
        CornerRadius="12"
        Margin="10"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5">

        <!-- 1. Define the Scale Transform (so it can zoom in) -->
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
        </Border.RenderTransform>

        <!-- 2. Trigger the Animation on Load -->
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource DialogPopIn}"/>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <ui:SymbolIcon Symbol="Folder24" FontSize="22" Foreground="{StaticResource EZBeat.Accent.Primary}" Margin="0,0,10,0"/>
                <TextBlock Text="Select Download Folder" Foreground="{StaticResource EZBeat.Foreground.Primary}" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>


            <TreeView x:Name="FolderTree" Grid.Row="1" 
              Background="Transparent" BorderThickness="0"
              VirtualizingStackPanel.IsVirtualizing="True"
              SelectedItemChanged="FolderTree_SelectedItemChanged">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <EventSetter Event="Expanded" Handler="FolderTree_Expanded"/>

                        <!-- THE FIX: Force selection on click -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>

                        <Style.Resources>
                            <!-- Remove Hover Effect -->
                            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="Transparent" />
                            <!-- Define Selection Color (Optional: Ensures it looks distinct) -->
                            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#335865F2" />
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                        <StackPanel Orientation="Horizontal" Margin="0,4" Background="Transparent">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" 
                                   Foreground="{StaticResource EZBeat.Accent.Primary}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource EZBeat.Foreground.Secondary}" 
                               VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Selected Path Preview (Updated Binding to Code Behind Property) -->
            <Border Grid.Row="2" Background="transparent" 
            CornerRadius="6" Padding="10" Margin="0,15,0,0">
                <!-- Changed Binding to use the Window's property directly for live updates -->
                <ui:TextBox x:Name="CurrentPathText" Text="Please select a folder..." 
IsReadOnly="True"
VerticalAlignment="Center"
Style="{StaticResource EZBeat.TextBox.Default}"
                            Foreground="{StaticResource EZBeat.Foreground.Primary}"/>

            </Border>

            

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Width="80" Margin="0,0,10,0"/>
                <ui:Button Content="Select" Style="{StaticResource EZBeat.Button.Primary}" Click="Select_Click" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>