<UserControl x:Class="EZBeat.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:EZBeat.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}">

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideFadeInDown}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Margin="20" MinHeight="48"
                Background="{StaticResource EZBeat.Background.Secondary}"
                BorderBrush="{StaticResource EZBeat.Control.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Direction="270" Color="Black" Opacity="0.4" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="20" Foreground="{StaticResource EZBeat.Foreground.Tertiary}" Margin="12,0,0,0"/>

                <ui:TextBox Grid.Column="1" x:Name="SearchTextBox"
                            PlaceholderText="Search for artists, songs, or albums..."
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            Padding="12,8"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource EZBeat.TextBox.Default}"
                            KeyDown="SearchTextBox_KeyDown"/>

                <Border Grid.Column="2" Width="1" Background="{StaticResource EZBeat.Control.Border}" Margin="0,10" />

                <ComboBox Grid.Column="3" 
                          x:Name="SourceComboBox" 
                          Style="{StaticResource EZBeat.ComboBox.SearchBarFilter}" 
                          SelectedIndex="0"
                          SelectionChanged="SourceComboBox_SelectionChanged">
                    <ComboBoxItem>SoundCloud</ComboBoxItem>
                    <ComboBoxItem>YouTube</ComboBoxItem>
                </ComboBox>

                <Border Grid.Column="4" Width="1" Background="{StaticResource EZBeat.Control.Border}" Margin="0,10" />

                <ComboBox Grid.Column="5" x:Name="SearchTypeComboBox" Style="{StaticResource EZBeat.ComboBox.SearchBarFilter}" SelectedIndex="0">
                    <ComboBoxItem>Track</ComboBoxItem>
                    <ComboBoxItem>Artist</ComboBoxItem>
                </ComboBox>

                <Border Grid.Column="6" Width="1" Background="{StaticResource EZBeat.Control.Border}" Margin="0,10" />

                <ComboBox Grid.Column="7" x:Name="AmountComboBox" Style="{StaticResource EZBeat.ComboBox.SearchBarFilter}" SelectedIndex="0">
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>25</ComboBoxItem>
                    <ComboBoxItem>50</ComboBoxItem>
                </ComboBox>

                <ui:Button Grid.Column="8" Content="Search"
                           Style="{StaticResource EZBeat.Button.Primary}"
                           Margin="8"
                           CornerRadius="6"
                           Click="SearchButton_Click" />
            </Grid>
        </Border>

        <!-- Search Results Container -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="20,0,20,110">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder"
                                    Background="{StaticResource EZBeat.Background.Secondary}"
                                    CornerRadius="6"
                                    Margin="0,0,0,12"
                                    Opacity="0"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource EZBeat.Control.Border}"
                                    SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Display">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="400" CenterY="50"/>
                                        <TranslateTransform Y="20"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" Color="Black" Opacity="0.3" BlurRadius="10"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource EZBeat.Color.Control.Hover}"
                                                                Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource EZBeat.Color.Background.Secondary}"
                                                                Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Artwork and Play Button -->
                                    <Button Grid.Column="0"
                                            Width="80" Height="80"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <Button.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ArtworkGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ArtworkGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ArtworkGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ArtworkGrid" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="PlayIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Button.Triggers>

                                        <Grid x:Name="ArtworkGrid">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="40" CenterY="40" />
                                            </Grid.RenderTransform>
                                            <Image Source="{Binding ArtworkUrl, Converter={StaticResource ImageSourceFallbackConverter}}" Stretch="Fill">
                                                <Image.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="80" Height="80" CornerRadius="6" Background="Black" />
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Image.OpacityMask>
                                            </Image>
                                            <Border x:Name="HoverOverlay" CornerRadius="6" Background="#66000000" Opacity="0"/>
                                            <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" Foreground="White" FontSize="28" IsHitTestVisible="False" Opacity="0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Text Info -->
                                    <StackPanel Grid.Column="1" Margin="15,0,15,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Foreground="{StaticResource EZBeat.Foreground.Primary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Author}" FontSize="14" Foreground="{StaticResource EZBeat.Foreground.Secondary}" Margin="0,0,0,8"/>

                                        <!-- Metadata Row -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource EZBeat.Accent.Source}" Opacity="0.9"/>

                                            <TextBlock Text=" • " FontSize="12" Margin="5,0" Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>

                                            <TextBlock Text="{Binding Duration, Converter={StaticResource TimeSpanConverter}}" FontSize="12" Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>

                                            <!-- NEW: Upload Date Section (Hidden if null) -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- Hide if UploadDate is null -->
                                                            <DataTrigger Binding="{Binding UploadDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text=" • " FontSize="12" Margin="5,0" Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>
                                                <!-- Formats date like: Jan 01, 2023 -->
                                                <TextBlock Text="{Binding UploadDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontSize="12" Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- DOWNLOAD ACTION AREA -->
                                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="130">

                                        <ui:Button Width="130"
           Command="{Binding DataContext.DownloadTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
           CommandParameter="{Binding}">

                                            <!-- This style block handles the inheritance (BasedOn) AND the triggers -->
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource EZBeat.Button.Primary}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>

                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload20" Margin="0,0,8,0"/>
                                                <TextBlock Text="Download" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <!-- 2. The Progress Bar Panel -->
                                        <!-- Visible only when Downloading -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Downloading..." 
                                                           FontSize="11" 
                                                           Foreground="{StaticResource EZBeat.Foreground.Secondary}"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock FontSize="11" 
                                                           Foreground="{StaticResource EZBeat.Accent.Primary}" 
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:0}%">
                                                            <Binding Path="DownloadProgress" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>

                                            <ProgressBar Value="{Binding DownloadProgress}" 
                                                         Maximum="100" 
                                                         Height="4" 
                                                         Width="130"
                                                         Background="{StaticResource EZBeat.Control.Border}"
                                                         Foreground="{StaticResource EZBeat.Accent.Primary}" 
                                                         BorderThickness="0"/>
                                        </StackPanel>

                                        <!-- 3. The "Downloaded" State -->
                                        <!-- Visible only when Downloaded -->
                                        <Border Background="Transparent" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource EZBeat.System.Success}" Margin="0,0,8,0" FontSize="20"/>
                                                <TextBlock Text="Saved" FontWeight="SemiBold" Foreground="{StaticResource EZBeat.System.Success}" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading Indicator -->
            <ui:ProgressRing
                x:Name="LoadingIndicator" IsIndeterminate="True" Width="60" Height="60"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="Collapsed" Foreground="{StaticResource EZBeat.Accent.Primary}"/>
        </Grid>
    </Grid>
</UserControl>