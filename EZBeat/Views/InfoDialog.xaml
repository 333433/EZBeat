<Window x:Class="EZBeat.Views.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Info"
        Height="220" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{x:Null}"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False">

    <!-- THE FIX: Added Margin="10" to give space for the shadow and corners -->
    <Border x:Name="MainBorder"
            Background="{StaticResource EZBeat.Background.Tertiary}"
            BorderBrush="{StaticResource EZBeat.Control.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <!-- This makes it scale from the center -->

        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource DialogPopIn}"/>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" 
                       Text="Information" 
                       Foreground="{StaticResource EZBeat.Foreground.Primary}" 
                       FontSize="18" 
                       FontWeight="SemiBold"/>

            <!-- Message -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15">
                <ui:SymbolIcon x:Name="MessageIcon" 
                               Symbol="Info24" 
                               FontSize="32" 
                               Foreground="{StaticResource EZBeat.Accent.Primary}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,15,0"/>

                <TextBlock x:Name="MessageText" 
                           Text="Message goes here..." 
                           Foreground="{StaticResource EZBeat.Foreground.Secondary}" 
                           FontSize="15" 
                           TextWrapping="Wrap" 
                           VerticalAlignment="Center"
                           MaxWidth="300"/>
            </StackPanel>

            <!-- OK Button -->
            <ui:Button Grid.Row="2" 
                       Content="OK" 
                       Style="{StaticResource EZBeat.Button.Primary}" 
                       HorizontalAlignment="Right" 
                       Width="80"
                       Click="OkButton_Click"/>
        </Grid>
    </Border>
</Window>