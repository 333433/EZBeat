<UserControl x:Class="EZBeat.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:EZBeat.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}">

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideFadeInDown}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="20" DataContext="{Binding DownloadsVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Downloads" FontSize="28" FontWeight="Bold" Foreground="{StaticResource EZBeat.Foreground.Primary}"/>
                <TextBlock Text="Manage your download history and queue." Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>
            </StackPanel>

            <ui:Button HorizontalAlignment="Right" 
                       VerticalAlignment="Top"
                       Icon="{ui:SymbolIcon Delete24}"
                       Cursor="Hand"
                       Content="Clear History"
                       Appearance="Secondary"
                       Command="{Binding ClearHistoryCommand}"/>
        </Grid>

        <!-- EMPTY STATE -->
        <TextBlock Grid.Row="1" 
                   Text="No download history."
                   FontSize="18"
                   Foreground="{StaticResource EZBeat.Foreground.Tertiary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- DOWNLOAD LIST -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource EZBeat.Background.Secondary}"
                                CornerRadius="8"
                                Margin="0,0,0,10"
                                Padding="12"
                                BorderBrush="{StaticResource EZBeat.Control.Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. ARTWORK -->
                                <Image Grid.Column="0" 
                                       Source="{Binding Track.ArtworkUrl, Converter={StaticResource ImageSourceFallbackConverter}}" 
                                       Width="50" Height="50" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,50,50" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>

                                <!-- 2. INFO (Title, Artist, Status) -->
                                <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Track.Title}" 
                                               Foreground="{StaticResource EZBeat.Foreground.Primary}" 
                                               FontWeight="SemiBold" 
                                               FontSize="15" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Artist + Source -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Track.Author}" Foreground="{StaticResource EZBeat.Foreground.Secondary}" FontSize="13"/>
                                        <TextBlock Text=" • " Foreground="{StaticResource EZBeat.Foreground.Tertiary}" FontSize="13"/>
                                        <TextBlock Text="{Binding Track.Source}" Foreground="{StaticResource EZBeat.Accent.Source}" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Status + Date -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource EZBeat.Foreground.Tertiary}"
                                                   FontStyle="Italic"/>
                                        <TextBlock Text=" • " Foreground="{StaticResource EZBeat.Foreground.Tertiary}" FontSize="12"/>
                                        <TextBlock Text="{Binding DateAdded, StringFormat='{}{0:g}'}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 3. ACTIONS / PROGRESS -->
                                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">

                                    <!-- A. Progress Bar (Visible when NOT completed) -->
                                    <Grid Width="200">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Progress}" 
                                                         Maximum="100" 
                                                         Height="6" 
                                                         Background="{StaticResource EZBeat.Background.Tertiary}"
                                                         Foreground="{StaticResource EZBeat.Accent.Primary}"
                                                         BorderThickness="0"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" 
                                                       HorizontalAlignment="Right" 
                                                       VerticalAlignment="Bottom" 
                                                       Margin="0,0,0,10" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource EZBeat.Foreground.Tertiary}"/>
                                        </Grid>
                                    </Grid>

                                    <!-- B. Completed Actions (Visible when COMPLETED) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <ui:Button Icon="{ui:SymbolIcon Folder24}"
                                                   Cursor="Hand"
                                                   Content="Open File"
                                                   Appearance="Secondary"
                                                   Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                   CommandParameter="{Binding FilePath}"/>

                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" 
                                                       Foreground="{StaticResource EZBeat.System.Success}" 
                                                       FontSize="24" 
                                                       Margin="15,0,0,0"
                                                       ToolTip="Download Completed"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>