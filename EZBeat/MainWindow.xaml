<ui:FluentWindow x:Class="EZBeat.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:EZBeat"
                 xmlns:views="clr-namespace:EZBeat.EZBeat.Views"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewmodels="clr-namespace:EZBeat.ViewModels" xmlns:converters="clr-namespace:EZBeat.EZBeat.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
                 Title="EZBeat"
                 Height="720" Width="1280"
                 MinWidth="950" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource EZBeat.Background.Default}"
                 Loaded="MainWindow_Loaded"
                 x:Name="MainWindowRoot">

    <Window.Resources>
        <DrawingImage x:Key="IconRewind">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <!-- Two Triangles Pointing Left -->
                        <PathGeometry Figures="M 20,0 L 20,20 L 10,10 Z M 10,0 L 10,20 L 0,10 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconForward">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <!-- Two Triangles Pointing Right -->
                        <PathGeometry Figures="M 0,0 L 0,20 L 10,10 Z M 10,0 L 10,20 L 20,10 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconPlay">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <!-- Triangle Pointing Right -->
                        <PathGeometry Figures="M 5,0 L 25,12 L 5,24 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconPause">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <!-- Two Vertical Bars -->
                        <PathGeometry Figures="M 6,0 L 12,0 L 12,24 L 6,24 Z M 18,0 L 24,0 L 24,24 L 18,24 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 2. CONVERTER FOR PLAY/PAUSE ICON SWITCHING -->
        <converters:TaskbarIconConverter x:Key="TaskbarStateConverter"
                                         PlayIcon="{StaticResource IconPlay}"
                                         PauseIcon="{StaticResource IconPause}"/>
        <!-- CUSTOM NAVIGATION BUTTON STYLE -->
        <Style x:Key="EZBeat.Button.Navigation" TargetType="ui:Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource EZBeat.Foreground.Secondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="MainBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="0">
                            <Grid>
                                <!-- The Content (Icon + Text) -->
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"/>

                                <!-- Selection Indicator (Small Bar) -->
                                <Rectangle x:Name="ActiveIndicator" 
                                Width="3" Height="15" 
                                Fill="{StaticResource EZBeat.Accent.Primary}" 
                                RadiusX="1.5" RadiusY="1.5"
                                HorizontalAlignment="Left" 
                                Margin="0,0,0,0" 
                                Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 1. HOVER STATE -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource EZBeat.Control.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- 2. PRESSED STATE -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource EZBeat.Control.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- 3. SELECTED / ACTIVE STATE (When IsEnabled is False) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource EZBeat.Control.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <!-- REWIND BUTTON -->
                <ThumbButtonInfo Description="Rewind 5s" 
                                 ImageSource="{StaticResource IconRewind}"
                                 Command="{Binding DataContext.Player.SeekBackwardCommand, ElementName=MainWindowRoot}"/>

                <!-- PLAY/PAUSE BUTTON (Icon switches dynamically) -->
                <ThumbButtonInfo Description="Play/Pause"
                                 ImageSource="{Binding DataContext.Player.IsPlaying, ElementName=MainWindowRoot, Converter={StaticResource TaskbarStateConverter}}"
                                 Command="{Binding DataContext.Player.PlayPauseCommand, ElementName=MainWindowRoot}"/>

                <!-- FAST FORWARD BUTTON -->
                <ThumbButtonInfo Description="Forward 5s"
                                 ImageSource="{StaticResource IconForward}"
                                 Command="{Binding DataContext.Player.SeekForwardCommand, ElementName=MainWindowRoot}"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Background="{StaticResource EZBeat.TitleBar.Primary}">
            <!-- The underlying TitleBar control (handles dragging and window buttons) -->
            <ui:TitleBar x:Name="AppTitleBar" Title="" ShowMaximize="True" ShowMinimize="True" 
                         Foreground="{StaticResource EZBeat.Foreground.Secondary}" 
                         Background="{StaticResource EZBeat.TitleBar.Primary}"/>

            <!-- LEFT: Logo -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,5,0,0">
                <Image Source="pack://application:,,,/Assets/Images/EZlogo.png" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>

            <!-- CENTER: Waveform Animation & Text -->
            <!-- IsHitTestVisible="False" ensures you can still drag the window by clicking this area -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">

                <views:WaveformIcon IsActive="{Binding Player.IsPlaying}"/>

                <TextBlock Text="Now Playing" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource EZBeat.Accent.Primary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
    </Grid>

    <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" HeaderVisibility="Collapsed" Navigated="OnNavigated" OpenPaneLength="200">
                <ui:NavigationView.MenuItems>
                    <!-- SEARCH BUTTON: Margin updated to 8,10,8,2 to match width of others -->
                    <ui:Button Style="{StaticResource EZBeat.Button.Navigation}" 
               Click="NavigationButton_Click" 
               Tag="{x:Type views:SearchView}"
               Margin="8,10,8,2">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="12,0,12,0"/>
                            <TextBlock Text="Search" FontSize="15" FontWeight="Medium"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- DOWNLOADS BUTTON (Uses default style margin 8,2) -->
                    <ui:Button Style="{StaticResource EZBeat.Button.Navigation}" 
               Click="NavigationButton_Click" 
               Tag="{x:Type views:DownloadsView}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="12,0,12,0"/>
                            <TextBlock Text="Downloads" FontSize="15" FontWeight="Medium"/>
                        </StackPanel>
                    </ui:Button>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <!-- SETTINGS BUTTON (Uses default style margin 8,2) -->
                    <ui:Button Style="{StaticResource EZBeat.Button.Navigation}" 
               Click="NavigationButton_Click" 
               Tag="{x:Type views:SettingsView}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="8,0,12,0"/>
                            <TextBlock Text="Settings" FontSize="15" FontWeight="Medium"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- UPDATE BUTTON (Uses default style margin 8,2) -->
                    <ui:Button Style="{StaticResource EZBeat.Button.Navigation}" 
               Click="UpdateButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="8,0,12,0"/>
                            <TextBlock Text="Check for Updates" FontSize="15" FontWeight="Medium"/>
                        </StackPanel>
                    </ui:Button>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- PLAYER SECTION -->
            <Border x:Name="AudioPlayer"
                    DataContext="{Binding Player}"
                    Panel.ZIndex="1"
                    VerticalAlignment="Bottom"
                    Height="90"
                    Margin="200,0,20,20"
                    Background="{StaticResource EZBeat.Background.Tertiary}"
BorderBrush="{StaticResource EZBeat.Control.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5" BlurRadius="15"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="120"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlayerVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0" Value="True"/>
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="120" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <!-- 1. Left: Text (Shrinks if needed) -->
                        <ColumnDefinition Width="*"/>

                        <!-- 2. Center: Controls -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- 3. Right: Volume (Prevent clipping with MinWidth) -->
                        <ColumnDefinition Width="*" MinWidth="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Artwork & Text Info -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Image Fixed -->
                            <ColumnDefinition Width="*"/>
                            <!-- Text Flexible -->
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="{Binding CurrentTrack.ArtworkUrl, Converter={StaticResource ImageSourceFallbackConverter}}" Width="64" Height="64" Stretch="Fill">
                            <Image.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="64" Height="64" CornerRadius="6" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Image.OpacityMask>
                        </Image>

                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <!-- TextTrimming works because the parent Grid constrains width -->
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Track Title'}" Foreground="{StaticResource EZBeat.Foreground.Primary}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CurrentTrack.Author, FallbackValue='Artist Name'}" Foreground="{StaticResource EZBeat.Foreground.Secondary}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- CENTER: Player Controls -->
                    <!-- CRITICAL FIX: Width reduced to 380 to prevent overlapping the volume controls -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                        <Button Style="{StaticResource EZBeat.Button.PlayerImageControl}" HorizontalAlignment="Center" Command="{Binding PlayPauseCommand}" Margin="0,0,0,12" />
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentPositionString, FallbackValue='0:00'}" Foreground="{StaticResource EZBeat.Foreground.Tertiary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Slider x:Name="PlayerSlider" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EZBeat.Slider.Player}" Maximum="{Binding TotalDurationSeconds, Mode=OneWay}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="PlayerSlider_DragStarted" PreviewMouseLeftButtonUp="PlayerSlider_DragCompleted" Thumb.DragStarted="PlayerSlider_ThumbDragStarted" Thumb.DragCompleted="PlayerSlider_ThumbDragCompleted" MouseMove="PlayerSlider_MouseMove" MouseLeave="PlayerSlider_MouseLeave"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalDurationString, FallbackValue='0:00'}" Foreground="{StaticResource EZBeat.Foreground.Tertiary}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- RIGHT: Volume & Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">

                            <!-- Mute Toggle Button -->
                            <Button Style="{StaticResource EZBeat.Button.IconHover}" 
                    Command="{Binding ToggleMuteCommand}"
                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="{Binding Volume, Converter={StaticResource VolumeIconConverter}}" 
                               Foreground="{StaticResource EZBeat.Foreground.Tertiary}" 
                               FontSize="21"/>
                            </Button>

                            <Slider x:Name="VolumeSlider" Width="80" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource EZBeat.Slider.Player}" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                        </StackPanel>

                        <Button Style="{StaticResource EZBeat.Button.IconHover}" VerticalAlignment="Center" Command="{Binding ClosePlayerCommand}">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>